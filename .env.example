# Stripe Payment Link URL (실제 결제)
# Stripe 대시보드 → Payment Links 에서 '일회성' 상품으로 링크를 만들고,
# 결제 후 리다이렉트(Confirmation page → "Don't show confirmation page" 대신
# "Redirect to your website")를 아래처럼 설정하세요:
#   https://<배포된-앱-주소>/?checkout=success&session_id={CHECKOUT_SESSION_ID}
#
# 그런 다음 이 파일을 복사해 .env 로 만들고 링크를 넣으세요:  cp .env.example .env
VITE_STRIPE_PAYMENT_LINK=
